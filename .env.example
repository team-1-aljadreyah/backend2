# Environment & Django Settings
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Encryption key for sensitive fields (e.g., delivery PIN reversible protection)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Database Selection: "sqlite" (default local dev) or "postgres" (staging/production)
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# PostgreSQL / Supabase Connection (used when DB_ENGINE=postgres)
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=true

# JWT Configuration
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# File Storage: "local" (default dev) or "supabase" (staging/production)
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_URL=/media/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PRODUCT_IMAGES=product-images
SUPABASE_BUCKET_DELIVERY_PROOFS=delivery-proofs
SIGNED_URL_TTL_SECONDS=900

# Redis & Celery (used for production workers, Channels WebSocket layer & distributed rate limits/cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CHANNELS_REDIS_URL=redis://localhost:6379/3
CELERY_TASK_ALWAYS_EAGER=true

# Real-time WebSocket settings
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_MAX_CONNECTIONS_PER_USER=5
REALTIME_MAX_MESSAGE_BYTES=16384
REALTIME_RATE_LIMIT_PER_10S=30

# Qi Card Payment Gateway (server-side only; never fake in production)
QI_CARD_BASE_URL=
QI_CARD_MERCHANT_ID=
QI_CARD_TERMINAL_ID=
QI_CARD_API_KEY=
QI_CARD_WEBHOOK_SECRET=
QI_CARD_MODE=disabled

# ZainCash Payment Gateway (API v2 UAT: https://pg-api-uat.zaincash.iq)
ZAINCASH_MSISDN=
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
ZAINCASH_ENV=test
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@alnahrain.iq

# Operational Security & Observability
METRICS_TOKEN=
API_ENABLE_DOCS=true
LOG_LEVEL=INFO
ALLOW_DEMO_SEED=true
